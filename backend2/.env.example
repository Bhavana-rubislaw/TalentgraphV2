# TalentGraph V2 Environment Variables

# JWT Secret Key (IMPORTANT: Must be 32+ bytes for SHA256 security)
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_JWT_SECRET=REPLACE_WITH_SECURE_32_BYTE_KEY_GENERATED_ABOVE

# PostgreSQL Database Connection
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talentgraph_v2

# ===================================================================
# SMTP Email Configuration (Dedicated TalentGraph Gmail Account)
# ===================================================================
# Interview emails are sent from a dedicated TalentGraph Gmail account
# to both candidate (To:) and recruiter (CC:), with Reply-To pointing to recruiter
#
# Setup Instructions:
# 1. Create/use dedicated Gmail account: talentgraph.interviews@gmail.com
# 2. Enable 2-Step Verification on the Gmail account
# 3. Generate App Password: https://myaccount.google.com/apppasswords
# 4. Use the 16-character App Password (NOT your regular Gmail password)
# 5. Fill in the values below
#
# NOTE: Never commit real passwords to version control
# ===================================================================

# Gmail SMTP server (default: smtp.gmail.com)
SMTP_HOST=smtp.gmail.com

# Gmail SMTP port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# Dedicated TalentGraph Gmail account username
SMTP_USERNAME=talentgraph.interviews@gmail.com

# Gmail App Password (16 characters from Google App Passwords)
# Get it from: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=
# From email address (should match SMTP_USERNAME for Gmail)
SMTP_FROM_EMAIL=talentgraph.interviews@gmail.com

# Display name in "From" field
SMTP_FROM_NAME=TalentGraph Interviews

# Use TLS encryption (required for Gmail on port 587)
SMTP_USE_TLS=true

# ===================================================================
# Seed/Test System Admin Account (used by scripts/seed and
# scripts/operations reset/reseed scripts - see app/core/seed_credentials.py)
# ===================================================================
# This is the login password for the in-app admin account these scripts
# create, separate from the SMTP credentials above. Leave SEED_ADMIN_PASSWORD
# blank to have scripts generate and locally cache a random one instead of
# using a fixed value.
SEED_ADMIN_EMAIL=talentgraph.interviews@gmail.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=TalentGraph System Admin

# ===================================================================
# Legacy environment variable support (for backward compatibility)
# If SMTP_* variables are not set, system falls back to MAIL_* variables
# ===================================================================
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=talentgraph.interviews@gmail.com
# MAIL_PASSWORD=your_google_app_password_here
# MAIL_FROM=talentgraph.interviews@gmail.com
# MAIL_FROM_NAME=TalentGraph Interviews

# ═══════════════════════════════════════════════════════════════════════════
# PHASE 3 & 4: PLATFORM EXPANSION
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# EMAIL SERVICE (Phase 3.2 - Inbound Email Threading)
# ───────────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_WEBHOOK_SECRET=your-webhook-verification-key
SENDGRID_FROM_EMAIL=noreply@talentgraph.com
SENDGRID_FROM_NAME=TalentGraph

# Reply-to domain for inbound email threading
REPLY_TO_DOMAIN=talentgraph.com
APP_BASE_URL=https://talentgraph.com
FRONTEND_URL=http://localhost:3003

# ───────────────────────────────────────────────────────────────────────────
# WORKERS & SCHEDULER (Phase 4.3 - Automation)
# ───────────────────────────────────────────────────────────────────────────
# Enable/disable background workers
WORKERS_ENABLED=true

# ───────────────────────────────────────────────────────────────────────────
# SECURITY & LIMITS
# ───────────────────────────────────────────────────────────────────────────
# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# ───────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ───────────────────────────────────────────────────────────────────────────
FEATURE_EMAIL_THREADING_ENABLED=true
FEATURE_ANALYTICS_ENABLED=true
FEATURE_LIFECYCLE_AUTOMATION_ENABLED=true

# ───────────────────────────────────────────────────────────────────────────
# STANDALONE RECOMMENDER  (ADR-001)
# ───────────────────────────────────────────────────────────────────────────
# Dedicated recommender database (leave blank to share core DB in local dev)
RECOMMENDER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talentgraph_recommender
RECOMMENDER_DB_POOL_SIZE=5
RECOMMENDER_DB_POOL_OVERFLOW=10

# Master switch — false bypasses recommender and uses legacy in-process path
RECOMMENDER_ENABLED=true

# Routing mode: local | standalone | shadow
#   local      — in-process scoring (zero new infra, safe default)
#   standalone — delegate to remote recommender service
#   shadow     — run both adapters, serve local result, record drift metrics
RECOMMENDER_MODE=local

# Persist drift metrics when mode=shadow
RECOMMENDER_SHADOW_COMPARE=false

# Enable/disable background sync and backfill workers independently
RECOMMENDER_WORKERS_ENABLED=true

# HTTP timeout (seconds) for calls to the remote standalone adapter
RECOMMENDER_TIMEOUT_SECONDS=2.0

# Minimum match score to include a candidate in recommendation results
RECOMMENDER_MIN_SCORE_THRESHOLD=35

# Remote standalone service base URL (used when mode=standalone or shadow)
RECOMMENDER_SERVICE_URL=http://localhost:8010

# ───────────────────────────────────────────────────────────────────────────
# ZOOM AUTO-GENERATED MEETING LINKS
# ───────────────────────────────────────────────────────────────────────────
# One company-wide Zoom Server-to-Server OAuth app — used to auto-generate
# a real Zoom link when a recruiter picks "Auto-generate Zoom link" while
# scheduling a meeting. Not a per-user credential; nothing to configure
# per recruiter. Leave blank to disable auto-generation (the manual
# "I'll provide my own link" option keeps working regardless).
# Create the app at: https://marketplace.zoom.us/ (Server-to-Server OAuth)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
